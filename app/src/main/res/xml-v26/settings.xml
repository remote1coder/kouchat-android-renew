<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  android:title="@string/settings_title">

  <net.usikkert.kouchat.android.component.NickNameEditTextPreference
      android:key="@string/settings_nick_name_key"
      android:title="@string/settings_nick_name_title"
      android:summary="@string/settings_nick_name_summary"
      android:dialogTitle="@string/settings_nick_name_title"
      android:dialogMessage="@string/settings_nick_name_dialog_message"
      android:dialogIcon="@drawable/ic_dialog"/>

  <net.usikkert.kouchat.android.component.HoloColorPickerPreference
      android:key="@string/settings_own_color_key"
      android:title="@string/settings_own_color_title"
      android:summary="@string/settings_own_color_summary"
      android:defaultValue="-15987646"
      android:dialogTitle="@string/settings_own_color_title"
      android:dialogIcon="@drawable/ic_dialog"/>

  <net.usikkert.kouchat.android.component.HoloColorPickerPreference
      android:key="@string/settings_sys_color_key"
      android:title="@string/settings_sys_color_title"
      android:summary="@string/settings_sys_color_summary"
      android:defaultValue="-16759040"
      android:dialogTitle="@string/settings_sys_color_title"
      android:dialogIcon="@drawable/ic_dialog"/>

  <CheckBoxPreference
      android:widgetLayout="@layout/two_state_preference"
      android:key="@string/settings_wake_lock_key"
      android:title="@string/settings_wake_lock_title"
      android:summary="@string/settings_wake_lock_summary"/>

  <ListPreference
      android:key="@string/settings_network_interface_key"
      android:title="@string/settings_network_interface_title"
      android:summary="@string/settings_network_interface_summary"
      android:dialogTitle="@string/settings_network_interface_dialog_title"
      android:defaultValue=""
      android:negativeButtonText="@string/cancel"/>

  <ListPreference
      android:key="@string/settings_network_mode_key"
      android:title="@string/settings_network_mode_title"
      android:summary="@string/settings_network_mode_summary"
      android:dialogTitle="@string/settings_network_mode_dialog_title"
      android:entries="@array/network_mode_entries"
      android:entryValues="@array/network_mode_values"
      android:defaultValue="multicast"
      android:negativeButtonText="@string/cancel"/>

  <ListPreference
      android:key="@string/settings_theme_mode_key"
      android:title="@string/settings_theme_mode_title"
      android:summary="@string/settings_theme_mode_summary"
      android:dialogTitle="@string/settings_theme_mode_dialog_title"
      android:entries="@array/theme_mode_entries"
      android:entryValues="@array/theme_mode_values"
      android:defaultValue="light"
      android:negativeButtonText="@string/cancel"/>

  <ListPreference
      android:key="@string/settings_dark_start_hour_key"
      android:title="@string/settings_dark_start_hour_title"
      android:summary="@string/settings_dark_start_hour_summary"
      android:dialogTitle="@string/settings_dark_start_hour_dialog_title"
      android:entries="@array/hour_entries"
      android:entryValues="@array/hour_values"
      android:defaultValue="18"
      android:negativeButtonText="@string/cancel"/>

  <ListPreference
      android:key="@string/settings_dark_end_hour_key"
      android:title="@string/settings_dark_end_hour_title"
      android:summary="@string/settings_dark_end_hour_summary"
      android:dialogTitle="@string/settings_dark_end_hour_dialog_title"
      android:entries="@array/hour_entries"
      android:entryValues="@array/hour_values"
      android:defaultValue="9"
      android:negativeButtonText="@string/cancel"/>

  <ListPreference
      android:key="@string/settings_auto_accept_files_key"
      android:title="@string/settings_auto_accept_files_title"
      android:summary="@string/settings_auto_accept_files_summary"
      android:dialogTitle="@string/settings_auto_accept_files_dialog_title"
      android:entries="@array/auto_accept_entries"
      android:entryValues="@array/auto_accept_values"
      android:defaultValue="images"
      android:negativeButtonText="@string/cancel"/>

  <ListPreference
      android:key="@string/settings_multicast_unicast_key"
      android:title="@string/settings_multicast_unicast_title"
      android:summary="@string/settings_multicast_unicast_summary"
      android:dialogTitle="@string/settings_multicast_unicast_dialog_title"
      android:entries="@array/multicast_unicast_entries"
      android:entryValues="@array/multicast_unicast_values"
      android:defaultValue="all"
      android:negativeButtonText="@string/cancel"/>

  <CheckBoxPreference
      android:widgetLayout="@layout/two_state_preference"
      android:key="@string/settings_auto_encrypt_unicast_key"
      android:title="@string/settings_auto_encrypt_unicast_title"
      android:summary="@string/settings_auto_encrypt_unicast_summary"
      android:defaultValue="true"/>

  <Preference
      android:title="@string/settings_notification_open_external_title"
      android:summary="@string/settings_notification_open_external_summary">
    <intent android:action="android.settings.APP_NOTIFICATION_SETTINGS">
      <extra android:name="android.provider.extra.APP_PACKAGE"
             android:value="net.usikkert.kouchat.android" />
    </intent>
  </Preference>

</PreferenceScreen>
